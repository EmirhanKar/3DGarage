# ==============================================================================
# MODIF-AI Backend Ortam Değişkenleri (.env.example)
# Bu dosyayı '.env' olarak kopyalayın ve gerçek değerleri girin.
# GÜVENLİK UYARISI: Asla eski sistem şifrelerini veya üretim anahtarlarını kullanmayın!
# ==============================================================================

# ── Veritabanı (Yeni boş geliştirme veritabanı) ──
# Eski 'modifiai' veritabanına bağlanmayın; 'modifi_ai_dev' adında yeni bir DB oluşturun.
DB_URL="postgresql+asyncpg://postgres:BURAYA_SIFRENIZI_YAZIN@localhost:5432/modifi_ai_dev"

# ── Güvenlik ve Kimlik Doğrulama ──
# JWT Token imzalama anahtarı (Örn: python -c "import secrets; print(secrets.token_urlsafe(32))")
MY_TOKEN="BURAYA_GUCLU_RASTGELE_JWT_SECRET_YAZIN"

# Yönetici API Anahtarı (X-Admin-Key header doğrulaması için)
ADMIN_API_KEY="BURAYA_GUCLU_RASTGELE_ADMIN_KEY_YAZIN"

# ── Tripo 3D API v3 Entegrasyonu ──
TRIPO_API_KEY="BURAYA_TRIPO_API_KEY_YAZIN"
TRIPO_BASE_URL="https://openapi.tripo3d.com/v3"
TRIPO_WEBHOOK_SECRET="BURAYA_TRIPO_WEBHOOK_SECRET_YAZIN"

# ── Araç Ön Kontrolü (Opsiyonel) ──
# Tripo kredisi harcamadan önce fotoğrafta araç olup olmadığını kontrol eden yerel yapay zeka bayrağı
ENABLE_CAR_PRECHECK=false

# ── Sistem ve Sunucu Ayarları ──
ENVIRONMENT="development"
BACKEND_PUBLIC_URL="http://localhost:8000"
ALLOWED_ORIGINS="*"
DISABLE_BACKGROUND_TASKS=false
